# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# environment

*env

*.env
planner/authentication/credentials.txt


# py cache

*_pycache_


# migrations

*migrations

*db.sqlite3

# media

*media

image.jpg
# Local development credientials
/planner/authentication/credentials.txt
/api_docs